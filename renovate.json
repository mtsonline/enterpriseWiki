{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Stay on the newest versions without manual work: daily updates, merged automatically when CI (build, Go tests, browser tests with axe, Docker build, license check) is green. See docs/admin/operations.md#automatische-updates.",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Vienna",
  "schedule": [
    "before 6am"
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "automergeStrategy": "squash",
  "rebaseWhen": "behind-base-branch",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "labels": [
    "dependencies"
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths",
    "npmDedupe"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "schedule": [
      "at any time"
    ],
    "labels": [
      "security"
    ]
  },
  "packageRules": [
    {
      "description": "Minor and patch updates of everything as one pull request per day",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "Major updates: one pull request each, also merged automatically when CI is green",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": true
    },
    {
      "description": "Keep the minimum language version ('go' directive) so the module still builds with older local Go versions; the toolchain line, the Dockerfile and CI always get the newest Go",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "enabled": false
    },
    {
      "description": "Node.js (only used to build the frontend): LTS versions only",
      "matchPackageNames": [
        "node"
      ],
      "versioning": "node"
    },
    {
      "description": "PostgreSQL: the recommended version in docker-compose*.yml, .env.example, internal/pgversion and the CI database – one pull request, merged when CI is green (also the upgrade test from older versions). Existing installations switch with ./docker-postgres-upgrade.sh.",
      "matchPackageNames": [
        "postgres"
      ],
      "automerge": true,
      "groupName": "PostgreSQL",
      "groupSlug": "postgres"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "PostgreSQL version of the CI test database",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "'(?<currentValue>\\d+)' \\}\\} # renovate: postgres"
      ],
      "depNameTemplate": "postgres",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "recommended PostgreSQL version of the Docker Compose files",
      "managerFilePatterns": [
        "/^docker-compose(\\.build)?\\.yml$/"
      ],
      "matchStrings": [
        "\\$\\{POSTGRES_VERSION:-(?<currentValue>\\d+)\\}"
      ],
      "depNameTemplate": "postgres",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "default PostgreSQL version of new installations",
      "managerFilePatterns": [
        "/^\\.env\\.example$/"
      ],
      "matchStrings": [
        "POSTGRES_VERSION=(?<currentValue>\\d+)"
      ],
      "depNameTemplate": "postgres",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "recommended PostgreSQL version shown to administrators",
      "managerFilePatterns": [
        "/^internal/pgversion/pgversion\\.go$/"
      ],
      "matchStrings": [
        "RecommendedMajor = (?<currentValue>\\d+) // renovate: postgres"
      ],
      "depNameTemplate": "postgres",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
