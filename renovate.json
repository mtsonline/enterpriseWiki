{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Stay on the newest versions without manual work: daily updates, merged automatically when CI (build, Go tests, browser tests with axe, Docker build, license check) is green. See docs/en/admin/operations.md#automatic-updates-of-the-components. config:best-practices pins GitHub Actions and Docker images to digests (supply chain).",
  "extends": [
    "config:best-practices",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Vienna",
  "schedule": [
    "before 6am"
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  "rebaseWhen": "behind-base-branch",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "labels": [
    "dependencies"
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths",
    "npmDedupe"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ],
    "minimumReleaseAge": null,
    "description": "Renovate cannot work out the age of the versions in a lock file refresh (its check would stay pending forever); the CI step tools/releaseage refuses versions younger than 3 days instead"
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "schedule": [
      "at any time"
    ],
    "labels": [
      "security"
    ]
  },
  "packageRules": [
    {
      "description": "Minor and patch updates of everything as one pull request per day",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "Major updates: one pull request each, also merged automatically when CI is green",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": true
    },
    {
      "description": "Pinning fixes versions and digests that are already in use (no new versions): no waiting time; Renovate cannot work out an age for it anyway",
      "matchUpdateTypes": [
        "pin",
        "pinDigest"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Keep the minimum language version ('go' directive) so the module still builds with older local Go versions; the toolchain line, the Dockerfile and CI always get the newest Go",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "enabled": false
    },
    {
      "description": "Node.js (only used to build the frontend): LTS versions only",
      "matchPackageNames": [
        "node"
      ],
      "versioning": "node"
    },
    {
      "description": "PostgreSQL: the recommended version in docker-compose*.yml, .env.example, internal/pgversion and the CI database – one pull request, merged when CI is green (also the upgrade test from older versions). Existing installations switch with ./docker-postgres-upgrade.sh.",
      "matchPackageNames": [
        "postgres"
      ],
      "automerge": true,
      "groupName": "PostgreSQL",
      "groupSlug": "postgres"
    },
    {
      "description": "Images whose version the administration chooses with a variable or a build argument (postgres:${POSTGRES_VERSION:-…}, crowdsec:${CROWDSEC_VERSION:-…}, caddy:${CADDY_VERSION}): a digest cannot be pinned there (Renovate failed every day with \"Error updating branch\"); the version itself is still updated",
      "matchFileNames": [
        "docker-compose.yml",
        "docker-compose.build.yml",
        "docker-compose.crowdsec.yml",
        "docker/caddy-crowdsec/Dockerfile",
        ".env.example",
        "internal/pgversion/pgversion.go",
        ".github/workflows/ci.yml"
      ],
      "matchPackageNames": [
        "postgres",
        "crowdsecurity/crowdsec",
        "caddy"
      ],
      "pinDigests": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "PostgreSQL version of the CI test database",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "'(?<currentValue>\\d+)' \\}\\} # renovate: postgres"
      ],
      "depNameTemplate": "postgres",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "recommended PostgreSQL version of the Docker Compose files",
      "managerFilePatterns": [
        "/^docker-compose(\\.build)?\\.yml$/"
      ],
      "matchStrings": [
        "\\$\\{POSTGRES_VERSION:-(?<currentValue>\\d+)\\}"
      ],
      "depNameTemplate": "postgres",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "default PostgreSQL version of new installations",
      "managerFilePatterns": [
        "/^\\.env\\.example$/"
      ],
      "matchStrings": [
        "POSTGRES_VERSION=(?<currentValue>\\d+)"
      ],
      "depNameTemplate": "postgres",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "recommended PostgreSQL version shown to administrators",
      "managerFilePatterns": [
        "/^internal/pgversion/pgversion\\.go$/"
      ],
      "matchStrings": [
        "RecommendedMajor = (?<currentValue>\\d+) // renovate: postgres"
      ],
      "depNameTemplate": "postgres",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "versions of test systems in scripts (annotated with '# renovate: datasource=… depName=…')",
      "managerFilePatterns": [
        "/^tests/(auth|search)/start\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\n[A-Z_]+=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Caddy version of the build with the CrowdSec bouncer",
      "managerFilePatterns": [
        "/^docker/caddy-crowdsec/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG CADDY_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "caddy",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "CrowdSec bouncer for Caddy",
      "managerFilePatterns": [
        "/^docker/caddy-crowdsec/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG BOUNCER_VERSION=(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "github.com/hslatman/caddy-crowdsec-bouncer",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "CrowdSec engine of docker-compose.crowdsec.yml",
      "managerFilePatterns": [
        "/^docker-compose\\.crowdsec\\.yml$/"
      ],
      "matchStrings": [
        "crowdsecurity/crowdsec:\\$\\{CROWDSEC_VERSION:-(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\}"
      ],
      "depNameTemplate": "crowdsecurity/crowdsec",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
