# Copy to .env and adjust – or run ./docker-setup.sh, which does it for you.
# Never commit .env.

# user and group the containers run as (./docker-setup.sh sets your own IDs)
EWIKI_UID=
EWIKI_GID=
# PostgreSQL major version of the data in ./data/postgres
# (./docker-postgres-upgrade.sh changes it after an upgrade)
POSTGRES_VERSION=18
# port on the host (with the bundled proxy or a local nginx: 127.0.0.1:8080,
# so the wiki is only reachable through the proxy)
EWIKI_PORT=8080
# image: latest (lite, small, no plugin installation) or full (installs and
# builds plugins, ~700 MB); also fixed versions such as 7.5 or 7.5-full
EWIKI_IMAGE_TAG=latest

POSTGRES_PASSWORD=change-me-db-password
EWIKI_ADMIN_USER=admin
# min. 12 characters, three of: lowercase, uppercase, digits, symbols
EWIKI_ADMIN_PASSWORD=Change-Me-Admin-42
EWIKI_SITE_NAME=Enterprise Wiki
EWIKI_BASE_URL=http://localhost:8080
EWIKI_LANGUAGES=en,de

# Outgoing e-mail (optional; can also be set later under Administration -> E-mail)
EWIKI_MAIL_FROM=
EWIKI_SMTP_HOST=
EWIKI_SMTP_PORT=587
EWIKI_SMTP_SECURITY=starttls
EWIKI_SMTP_USER=
EWIKI_SMTP_PASSWORD=

# How the wiki is reached (asked by ./docker-setup.sh): proxy = HTTPS through
# the bundled proxy, off = plain HTTP on EWIKI_PORT
EWIKI_HTTPS=
# HTTPS with the bundled reverse proxy (Caddy): set COMPOSE_PROFILES=proxy,
# EWIKI_BASE_URL=https://your.host and an e-mail address for the certificate
# authority. Certificates for the base URL and all site host names are
# obtained on the first visit and renewed automatically.
#COMPOSE_PROFILES=proxy
# letsencrypt, letsencrypt-staging (for trying out) or zerossl
EWIKI_ACME=letsencrypt
EWIKI_ACME_EMAIL=
EWIKI_HTTP_PORT=80
EWIKI_HTTPS_PORT=443

# Reverse proxies whose X-Forwarded-For header is trusted (IPs or CIDRs,
# comma-separated). Default: the bundled proxy (172.30.80.2). A proxy on the
# host (nginx, Apache) connecting to EWIKI_PORT appears as 172.30.80.1.
#EWIKI_TRUSTED_PROXIES=172.30.80.1
# Docker network of the containers (change only if it collides with yours)
#EWIKI_SUBNET=172.30.80.0/24
#EWIKI_PROXY_IP=172.30.80.2
