{
  "comment": "Limits of data templates. Read by the server (check on saving) and by the designer (what has room). One file, so both always agree.",
  "rem_px": 16,
  "views": {
    "desktop": { "min_px": 1024, "content_min_rem": 36 },
    "tablet": { "min_px": 640, "content_min_rem": 24 },
    "mobile": { "min_px": 320, "content_min_rem": 16 }
  },
  "gap_rem": 1,
  "padding_rem": 1,
  "block_min_rem": { "area": 8, "brand": 8, "content": 0 },
  "block_max_rem": 40,
  "position_min_rem": 4,
  "position_gap_rem": 0.5,
  "sticky_max_vh": 25,
  "max_rows": 20,
  "max_blocks_per_row": 8,
  "max_blocks": 40,
  "max_positions_per_block": 8,
  "max_positions": 60,
  "label_max": 60,
  "name_max": 80,
  "scale_percent": [100, 125],
  "radius_px": [0, 16],
  "content_width_rem": [40, 120],
  "contrast_text": 4.5,
  "contrast_ui": 3,
  "contrast_pairs_comment": "pairs of tokens shown together; on the header and footer the focus ring has their text color (checked by the header and footer pairs)",
  "contrast_pairs": [
    { "fore": "text", "back": "bg", "ui": false, "rule": "1.4.3" },
    { "fore": "text", "back": "bg_subtle", "ui": false, "rule": "1.4.3" },
    { "fore": "text_muted", "back": "bg", "ui": false, "rule": "1.4.3" },
    { "fore": "text_muted", "back": "bg_subtle", "ui": false, "rule": "1.4.3" },
    { "fore": "link", "back": "bg", "ui": false, "rule": "1.4.3" },
    { "fore": "link", "back": "bg_subtle", "ui": false, "rule": "1.4.3" },
    { "fore": "on_primary", "back": "primary", "ui": false, "rule": "1.4.3" },
    { "fore": "header_text", "back": "header_bg", "ui": false, "rule": "1.4.3" },
    { "fore": "footer_text", "back": "footer_bg", "ui": false, "rule": "1.4.3" },
    { "fore": "primary", "back": "bg", "ui": true, "rule": "1.4.11" },
    { "fore": "border", "back": "bg", "ui": true, "rule": "1.4.11" },
    { "fore": "focus", "back": "bg", "ui": true, "rule": "2.4.13" },
    { "fore": "focus", "back": "bg_subtle", "ui": true, "rule": "2.4.13" }
  ],
  "fonts": ["system", "inter", "source-sans", "serif", "mono"],
  "max_bytes": 65536,
  "css": {
    "comment": "Own CSS of a template (only when ui.custom_css allows it). Checked on the comment-free, lower-case text; server and designer read these rules.",
    "max_bytes": 32768,
    "forbidden": [
      ["<", "the character <"],
      ["\\\\", "escapes with a backslash"],
      ["@import", "@import"],
      ["@namespace", "@namespace"],
      ["expression\\s*\\(", "expression()"],
      ["behavior\\s*:", "behavior"],
      ["-moz-binding", "-moz-binding"],
      ["javascript\\s*:", "javascript:"],
      ["image-set\\s*\\(", "image-set()"],
      ["cross-fade\\s*\\(", "cross-fade()"],
      ["element\\s*\\(", "element()"],
      ["(^|[^a-z-])image\\s*\\(", "image()"],
      ["(^|[^a-z-])src\\s*\\(", "src()"]
    ],
    "url": "^/api/v1/(files/[a-z0-9._-]{1,128}|media/[0-9]{1,18}/view)$"
  }
}
