{
  "id": "theme.cms",
  "name": "CMS / website template",
  "version": "1.0.0",
  "description": "Website layout (inspired by classic business themes): large header with main navigation of the top categories, full-width content for layout builder sections (hero, sections, cards), sidebar below the content and a footer with columns. Offers the positions header-nav, header-tools, sidebar and footer.",
  "author": "Enterprise Wiki",
  "kinds": [
    "template"
  ],
  "extends": [],
  "frontend": true,
  "color_scheme": "system",
  "template_settings": [
    {
      "key": "primary_color",
      "kind": "color",
      "group": "colors",
      "default": "#0a3760",
      "css_vars": [
        "--ewcms-primary-l"
      ],
      "scheme": "light",
      "contrast_on": [
        "page_bg",
        "surface"
      ],
      "label": {
        "en": "Primary colour (light)",
        "de": "Hauptfarbe (hell)"
      },
      "help": {
        "en": "Links, buttons, active menu items and the plain start image.",
        "de": "Links, Schaltflächen, aktive Menüpunkte und das Startbild ohne Foto."
      }
    },
    {
      "key": "primary_color_dark",
      "kind": "color",
      "group": "colors",
      "default": "#85b8ff",
      "css_vars": [
        "--ewcms-primary-d"
      ],
      "scheme": "dark",
      "contrast_on": [
        "page_bg_dark",
        "surface_dark"
      ],
      "label": {
        "en": "Primary colour (dark)",
        "de": "Hauptfarbe (dunkel)"
      },
      "help": {
        "en": "Links, buttons, active menu items and the plain start image.",
        "de": "Links, Schaltflächen, aktive Menüpunkte und das Startbild ohne Foto."
      }
    },
    {
      "key": "page_bg",
      "kind": "color",
      "group": "colors",
      "default": "#f6f6f6",
      "css_vars": [
        "--ewcms-page-bg"
      ],
      "scheme": "light",
      "label": {
        "en": "Page background (light)",
        "de": "Seitenhintergrund (hell)"
      }
    },
    {
      "key": "page_bg_dark",
      "kind": "color",
      "group": "colors",
      "default": "#16191d",
      "css_vars": [
        "--ewcms-page-bg"
      ],
      "scheme": "dark",
      "label": {
        "en": "Page background (dark)",
        "de": "Seitenhintergrund (dunkel)"
      }
    },
    {
      "key": "surface",
      "kind": "color",
      "group": "colors",
      "default": "#ffffff",
      "css_vars": [
        "--ewcms-surface"
      ],
      "scheme": "light",
      "label": {
        "en": "Background of the content (light)",
        "de": "Hintergrund des Inhalts (hell)"
      }
    },
    {
      "key": "surface_dark",
      "kind": "color",
      "group": "colors",
      "default": "#1d2125",
      "css_vars": [
        "--ewcms-surface"
      ],
      "scheme": "dark",
      "label": {
        "en": "Background of the content (dark)",
        "de": "Hintergrund des Inhalts (dunkel)"
      }
    },
    {
      "key": "text",
      "kind": "color",
      "group": "colors",
      "default": "#333333",
      "css_vars": [
        "--ewcms-text"
      ],
      "scheme": "light",
      "contrast_on": [
        "page_bg",
        "surface"
      ],
      "label": {
        "en": "Text (light)",
        "de": "Text (hell)"
      }
    },
    {
      "key": "text_dark",
      "kind": "color",
      "group": "colors",
      "default": "#dee4ea",
      "css_vars": [
        "--ewcms-text"
      ],
      "scheme": "dark",
      "contrast_on": [
        "page_bg_dark",
        "surface_dark"
      ],
      "label": {
        "en": "Text (dark)",
        "de": "Text (dunkel)"
      }
    },
    {
      "key": "heading",
      "kind": "color",
      "group": "colors",
      "default": "#222222",
      "css_vars": [
        "--ewcms-heading"
      ],
      "scheme": "light",
      "contrast_on": [
        "page_bg",
        "surface"
      ],
      "label": {
        "en": "Headings (light)",
        "de": "Überschriften (hell)"
      }
    },
    {
      "key": "heading_dark",
      "kind": "color",
      "group": "colors",
      "default": "#f1f4f7",
      "css_vars": [
        "--ewcms-heading"
      ],
      "scheme": "dark",
      "contrast_on": [
        "page_bg_dark",
        "surface_dark"
      ],
      "label": {
        "en": "Headings (dark)",
        "de": "Überschriften (dunkel)"
      }
    },
    {
      "key": "muted",
      "kind": "color",
      "group": "colors",
      "default": "#666666",
      "css_vars": [
        "--ewcms-muted"
      ],
      "scheme": "light",
      "contrast_on": [
        "page_bg",
        "surface"
      ],
      "label": {
        "en": "Quiet text (light)",
        "de": "Dezenter Text (hell)"
      }
    },
    {
      "key": "muted_dark",
      "kind": "color",
      "group": "colors",
      "default": "#b6c2cf",
      "css_vars": [
        "--ewcms-muted"
      ],
      "scheme": "dark",
      "contrast_on": [
        "page_bg_dark",
        "surface_dark"
      ],
      "label": {
        "en": "Quiet text (dark)",
        "de": "Dezenter Text (dunkel)"
      }
    },
    {
      "key": "line",
      "kind": "color",
      "group": "colors",
      "default": "#e6e6e6",
      "css_vars": [
        "--ewcms-line"
      ],
      "scheme": "light",
      "label": {
        "en": "Lines (light)",
        "de": "Linien (hell)"
      }
    },
    {
      "key": "line_dark",
      "kind": "color",
      "group": "colors",
      "default": "#3a434c",
      "css_vars": [
        "--ewcms-line"
      ],
      "scheme": "dark",
      "label": {
        "en": "Lines (dark)",
        "de": "Linien (dunkel)"
      }
    },
    {
      "key": "aside_bg",
      "kind": "color",
      "group": "colors",
      "default": "#ececec",
      "css_vars": [
        "--ewcms-aside-bg"
      ],
      "scheme": "light",
      "label": {
        "en": "Background below the content (light)",
        "de": "Hintergrund unter dem Inhalt (hell)"
      }
    },
    {
      "key": "aside_bg_dark",
      "kind": "color",
      "group": "colors",
      "default": "#22272b",
      "css_vars": [
        "--ewcms-aside-bg"
      ],
      "scheme": "dark",
      "label": {
        "en": "Background below the content (dark)",
        "de": "Hintergrund unter dem Inhalt (dunkel)"
      }
    },
    {
      "key": "footer_bg",
      "kind": "color",
      "group": "colors",
      "default": "#222222",
      "css_vars": [
        "--ewcms-dark"
      ],
      "scheme": "light",
      "label": {
        "en": "Background of the footer (light)",
        "de": "Hintergrund des Fußbereichs (hell)"
      }
    },
    {
      "key": "footer_bg_dark",
      "kind": "color",
      "group": "colors",
      "default": "#101317",
      "css_vars": [
        "--ewcms-dark"
      ],
      "scheme": "dark",
      "label": {
        "en": "Background of the footer (dark)",
        "de": "Hintergrund des Fußbereichs (dunkel)"
      }
    },
    {
      "key": "socket_bg",
      "kind": "color",
      "group": "colors",
      "default": "#151515",
      "css_vars": [
        "--ewcms-darker"
      ],
      "scheme": "light",
      "label": {
        "en": "Background of the bottom line (light)",
        "de": "Hintergrund der untersten Zeile (hell)"
      }
    },
    {
      "key": "socket_bg_dark",
      "kind": "color",
      "group": "colors",
      "default": "#0b0d10",
      "css_vars": [
        "--ewcms-darker"
      ],
      "scheme": "dark",
      "label": {
        "en": "Background of the bottom line (dark)",
        "de": "Hintergrund der untersten Zeile (dunkel)"
      }
    },
    {
      "key": "font",
      "kind": "font",
      "group": "fonts",
      "default": "source-sans",
      "options": [
        "source-sans",
        "inter",
        "system",
        "serif"
      ],
      "css_vars": [
        "--ewcms-font"
      ],
      "label": {
        "en": "Text",
        "de": "Text"
      }
    },
    {
      "key": "heading_font",
      "kind": "font",
      "group": "fonts",
      "default": "source-sans",
      "options": [
        "source-sans",
        "inter",
        "poppins",
        "system",
        "serif"
      ],
      "css_vars": [
        "--ewcms-heading-font"
      ],
      "label": {
        "en": "Headings",
        "de": "Überschriften"
      }
    },
    {
      "key": "logo",
      "kind": "image",
      "group": "logos",
      "role": "logo",
      "default_src": "/brand/logo.webp",
      "label": {
        "en": "Logo",
        "de": "Logo"
      },
      "help": {
        "en": "PNG, WebP or JPEG, ideally with a transparent background.",
        "de": "PNG, WebP oder JPEG, am besten mit transparentem Hintergrund."
      }
    },
    {
      "key": "logo_light",
      "kind": "image",
      "group": "logos",
      "role": "logo_on_dark",
      "label": {
        "en": "Logo on a dark background",
        "de": "Logo auf dunklem Hintergrund"
      },
      "help": {
        "en": "Shown in the dark colour scheme. Without it the logo is shown.",
        "de": "Im dunklen Farbschema gezeigt. Ohne dieses Bild erscheint das Logo."
      }
    },
    {
      "key": "mark",
      "kind": "image",
      "group": "logos",
      "role": "mark",
      "default_src": "/brand/mark.webp",
      "label": {
        "en": "Mark (narrow screens)",
        "de": "Bildmarke (schmale Bildschirme)"
      },
      "help": {
        "en": "The small sign without text, shown on phones next to the name of the site.",
        "de": "Das kleine Zeichen ohne Schrift, auf Handys neben dem Namen der Website."
      }
    },
    {
      "key": "mark_on_dark",
      "kind": "image",
      "group": "logos",
      "role": "mark_on_dark",
      "label": {
        "en": "Mark on a dark background",
        "de": "Bildmarke auf dunklem Hintergrund"
      },
      "help": {
        "en": "Shown on narrow screens in the dark colour scheme.",
        "de": "Auf schmalen Bildschirmen im dunklen Farbschema gezeigt."
      }
    },
    {
      "key": "logo_height",
      "kind": "number",
      "group": "logos",
      "default": 56,
      "min": 24,
      "max": 120,
      "step": 1,
      "label": {
        "en": "Logo height (pixels)",
        "de": "Logo-Höhe (Pixel)"
      },
      "help": {
        "en": "Default 56; the logo gets smaller when scrolling.",
        "de": "Standard 56, beim Scrollen wird das Logo kleiner."
      },
      "css_vars": [
        "--ewcms-logo-h"
      ],
      "unit": "px"
    },
    {
      "key": "header",
      "kind": "select",
      "group": "header",
      "default": "overlay",
      "options": [
        "overlay",
        "solid"
      ],
      "label": {
        "en": "Header",
        "de": "Kopfbereich"
      },
      "option_labels": {
        "overlay": {
          "en": "Transparent over the start image, white when scrolling",
          "de": "Transparent über dem Startbild, beim Scrollen weiß"
        },
        "solid": {
          "en": "Always white",
          "de": "Immer weiß"
        }
      }
    },
    {
      "key": "hero_image",
      "kind": "image",
      "group": "content",
      "label": {
        "en": "Start image",
        "de": "Startbild"
      },
      "help": {
        "en": "Large image at the top of the start page, e.g. 2400 × 1200 pixels.",
        "de": "Großes Bild oben auf der Startseite, z. B. 2400 × 1200 Pixel."
      }
    },
    {
      "key": "hero_title",
      "kind": "text",
      "group": "content",
      "default": "",
      "max_len": 120,
      "label": {
        "en": "Title in the start image",
        "de": "Titel im Startbild"
      }
    },
    {
      "key": "hero_subtitle",
      "kind": "text",
      "group": "content",
      "default": "",
      "max_len": 240,
      "label": {
        "en": "Subtitle",
        "de": "Untertitel"
      }
    },
    {
      "key": "hero_button_label",
      "kind": "text",
      "group": "content",
      "default": "",
      "max_len": 60,
      "label": {
        "en": "Button: text",
        "de": "Schaltfläche: Text"
      }
    },
    {
      "key": "hero_button_link",
      "kind": "link",
      "group": "content",
      "default": "",
      "label": {
        "en": "Button: link",
        "de": "Schaltfläche: Link"
      }
    },
    {
      "key": "hero_size",
      "kind": "select",
      "group": "content",
      "default": "large",
      "options": [
        "large",
        "medium"
      ],
      "label": {
        "en": "Height of the start image",
        "de": "Höhe des Startbilds"
      },
      "option_labels": {
        "large": {
          "en": "Large",
          "de": "Groß"
        },
        "medium": {
          "en": "Medium",
          "de": "Mittel"
        }
      }
    },
    {
      "key": "banner",
      "kind": "bool",
      "group": "content",
      "default": false,
      "label": {
        "en": "Title banner on sub pages",
        "de": "Titelbanner auf Unterseiten"
      },
      "help": {
        "en": "Shows the page title large over an image (as on university websites).",
        "de": "Zeigt den Seitentitel groß über einem Bild (wie auf Hochschul-Websites)."
      }
    },
    {
      "key": "banner_image",
      "kind": "image",
      "group": "content",
      "label": {
        "en": "Image for title banners",
        "de": "Bild für Titelbanner"
      },
      "help": {
        "en": "Without its own image the start image is used.",
        "de": "Ohne eigenes Bild wird das Startbild verwendet."
      }
    },
    {
      "key": "copyright",
      "kind": "text",
      "group": "footer",
      "default": "",
      "max_len": 200,
      "label": {
        "en": "Copyright line",
        "de": "Copyright-Zeile"
      },
      "help": {
        "en": "e.g. “© {year} Example University” – {year} is replaced by the current year.",
        "de": "z. B. „© {year} Universität Musterstadt“ – {year} wird durch das aktuelle Jahr ersetzt."
      }
    },
    {
      "key": "back_to_top",
      "kind": "bool",
      "group": "layout",
      "default": true,
      "label": {
        "en": "Back to top",
        "de": "Nach oben"
      }
    }
  ],
  "template_look_root": ".ewcms-app"
}
