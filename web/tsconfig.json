{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@ewiki/sdk": [
        "./src/sdk.ts"
      ]
    },
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "../plugins/*/web/**/*.ts",
    "src/env.d.ts"
  ]
}
